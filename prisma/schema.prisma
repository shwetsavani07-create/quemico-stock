generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  ADD
  SELL
}

model Product {
  id                String   @id @default(cuid())
  name              String
  image             String?
  lowStockThreshold Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockBatches   StockBatch[]
  stockMovements StockMovement[]

  @@index([name])
}

model StockBatch {
  id                String   @id @default(cuid())
  productId         String
  quantity          Int
  remainingQuantity Int
  pricePerPiece     Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations StockMovementAllocation[]

  @@index([productId, createdAt])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  type          MovementType
  quantity      Int
  value         Decimal      @db.Decimal(14, 2)
  pricePerPiece Decimal?     @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())

  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations StockMovementAllocation[]

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([type])
}

model StockMovementAllocation {
  id            String  @id @default(cuid())
  movementId    String
  batchId       String
  quantity      Int
  pricePerPiece Decimal @db.Decimal(12, 2)
  value         Decimal @db.Decimal(14, 2)

  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  batch    StockBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([movementId])
  @@index([batchId])
}
